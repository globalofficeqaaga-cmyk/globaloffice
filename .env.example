# Supabase Configuration (Client-side public Vite environment variables)
# For local development, copy this file to .env.local at the project root.
# In Google AI Studio, add these in Settings -> Secrets / Environment Variables.
# IMPORTANT: Use ONLY your Project URL and public Publishable (or anon) key.
# NEVER put a service_role or sb_secret_ key in any VITE_* variable.
# Public client-side Vite environment variables
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# SERVER-ONLY SECRET (never prefix with VITE_ and never expose in browser code)
# Required by server.ts for Admin Dashboard creation/reset/deletion of Staff and
# Accounts logins via official Supabase Auth Admin APIs.
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Optional, for server-side Gemini AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected automatically at runtime).
APP_URL="MY_APP_URL"
